// Notely database schema
// Design decisions: docs/erd.md, docs/adr/0007-prisma-7-with-mariadb-adapter.md, docs/adr/0008-uuidv7-primary-keys.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Char(36)
  /// Stored lowercase; the table collation (utf8mb4_unicode_ci) also makes the unique index case-insensitive
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(100)
  /// argon2id hash, never the plain password
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  sessions Session[]
  notes    Note[]

  @@map("users")
}

/// One row per signed-in device. The refresh token hash is replaced on every rotation.
model Session {
  id                       String    @id @default(uuid(7)) @db.Char(36)
  userId                   String    @map("user_id") @db.Char(36)
  /// SHA-256 hex digest of the current refresh token secret
  refreshTokenHash         String    @map("refresh_token_hash") @db.Char(64)
  /// Hash of the secret this session rotated away from. Presenting it again is token reuse.
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.Char(64)
  userAgent                String?   @map("user_agent") @db.VarChar(512)
  ipAddress                String?   @map("ip_address") @db.VarChar(45)
  expiresAt                DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt                DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Note {
  id         String    @id @default(uuid(7)) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  title      String    @db.VarChar(255)
  /// MEDIUMTEXT: TEXT is limited to 65,535 bytes, and utf8mb4 uses up to 4 bytes per character
  content    String    @db.MediumText
  isPinned   Boolean   @default(false) @map("is_pinned")
  isArchived Boolean   @default(false) @map("is_archived")
  /// Soft delete: null means the note is active
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Serves the most common query: a user's non-deleted notes, newest first
  @@index([userId, deletedAt, updatedAt])
  @@map("notes")
}
