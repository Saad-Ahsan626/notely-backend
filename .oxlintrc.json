{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "env": {
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": "off",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "eqeqeq": "error",
    "no-console": "error",
    "no-var": "error",
    "prefer-const": "error",
    "import/no-cycle": "error"
  },
  "ignorePatterns": ["dist/**", "coverage/**", "src/generated/**"],
  "overrides": [
    {
      // CLI scripts report progress on the console
      "files": ["prisma/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Tests build partial fakes (`{ switchToHttp } as ArgumentsHost`) and assert on spied
      // methods (`expect(obj.method)`), which these rules flag as unsafe in application code.
      "files": ["**/*.spec.ts", "test/**/*.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/unbound-method": "off"
      }
    }
  ]
}
