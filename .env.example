# Copy this file to .env and adjust the values. Never commit .env.

# development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# The user, databases and this local-only default password come from scripts/db/init.sql
# (see docs/local-database-setup.md).
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=mysql://notely:change_me_local_password@localhost:3306/notely_dev

# Maximum open database connections for this app instance (1-100)
DATABASE_POOL_SIZE=10

# Prisma CLI only (`npm run db:migrate`): scratch database used to detect schema drift.
# Not read by the running app.
SHADOW_DATABASE_URL=mysql://notely:change_me_local_password@localhost:3306/notely_shadow

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Browser origins allowed by CORS, comma-separated (e.g. http://localhost:5173).
# Leave empty to allow none. Mobile apps are not affected by CORS.
CORS_ORIGINS=

# Number of trusted reverse proxies / load balancers in front of the app (0 = none).
# Client IPs are then read from X-Forwarded-For. Never set this higher than the real count.
TRUST_PROXY=0

# Access token signing key. Generate a real one with: npm run secret:generate
# This placeholder works in development and tests but is REJECTED in production.
JWT_ACCESS_SECRET=dev-only-example-secret-change-me-before-deploying

# Access token lifetime in minutes (1-60)
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token lifetime in days (1-90)
REFRESH_TOKEN_TTL_DAYS=7

# Login/registration attempts allowed per IP per minute
AUTH_RATE_LIMIT_PER_MINUTE=5
